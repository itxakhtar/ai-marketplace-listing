# Required: get a key at https://aistudio.google.com/apikey  (never commit your real .env)
GEMINI_API_KEY=your-api-key-here

# Run `python -m scripts.list_models` to see which models your key can use.
# Use the name WITHOUT the "models/" prefix.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
# Optional: a different model for the full-description step (defaults to GEMINI_MODEL)
# GEMINI_TEXT_MODEL=
# Model that creates the related AI pictures. Pick an image-capable name from list_models.
GEMINI_IMAGE_MODEL=gemini-3.6-flash-image

# --- Upload limits ---
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGES_PER_REQUEST=6

# --- Timeouts (seconds) ---
# One call to the vision provider
API_TIMEOUT=60
# Whole /generate-listing request, retries included (keep below the UI's 120 s)
REQUEST_TIMEOUT=110

# --- Image preparation / quality heuristics ---
INFERENCE_MAX_EDGE=1568
JPEG_QUALITY=85
LOW_RES_EDGE=300
DARK_THRESHOLD=40
BLUR_THRESHOLD=12

# --- Resilience ---
VISION_MAX_RETRIES=1
VISION_RETRY_BACKOFF_S=1.0
VISION_MAX_CONCURRENCY=4
MAX_AI_ATTEMPTS=2

# Reject listings that state storage/RAM/battery numbers (true = safer)
BLOCK_UNVERIFIED_SPECS=true

# --- Marketplace extras ---
ENABLE_DESCRIPTION_EXPANSION=true
ENABLE_IMAGE_GENERATION=true
# 1-3 related pictures per listing (each one is a separate, billable model call)
RELATED_IMAGE_COUNT=3
IMAGE_GEN_TIMEOUT=75
# Burn an "AI-generated" label into generated pictures (keep this on)
WATERMARK_GENERATED_IMAGES=true
# Set to false in production to hide /docs, /redoc and /openapi.json
ENABLE_DOCS=true

LOG_LEVEL=INFO
